{
  "name": "contribsutra-ai",
  "version": "0.2.1",
  "description": "ContribSutra AI: offline, evidence-backed open-source contributor onboarding CLI plus 25 portable Agent Skills (Claude Code, Cursor, Codex, Copilot, Gemini CLI). Teaches contributors; protects maintainers from PR spam. No API keys, no network.",
  "author": {
    "name": "Vatsal Shah",
    "url": "https://github.com/shahvatsalofficial"
  },
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "contribsutra": "packages/cli/index.mjs",
    "contribsutra-ai": "packages/cli/index.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "doctor": "node packages/cli/index.mjs doctor",
    "demo": "node scripts/demo.mjs",
    "audit": "node packages/cli/index.mjs audit --out examples/reports/audit --force",
    "pack:check": "npm pack --dry-run",
    "proof": "node scripts/proof.mjs"
  },
  "homepage": "https://github.com/shahvatsalofficial/contribsutra-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahvatsalofficial/contribsutra-ai.git"
  },
  "bugs": {
    "url": "https://github.com/shahvatsalofficial/contribsutra-ai/issues"
  },
  "keywords": [
    "open-source",
    "first-contribution",
    "good-first-issue",
    "contributor-onboarding",
    "hacktoberfest",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "github-copilot",
    "gemini-cli",
    "mcp",
    "audit",
    "evidence",
    "maintainer",
    "cli",
    "llm",
    "offline"
  ],
  "files": [
    "packages",
    "skills",
    "agents",
    ".claude/agents",
    "fixtures",
    "schemas",
    "rules",
    "policies",
    "workflows",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
