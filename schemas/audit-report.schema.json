{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shahvatsalofficial/contribsutra-ai/schemas/audit-report.schema.json",
  "title": "contribsutra.audit-report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "verdict",
    "assurance",
    "findings",
    "evidence",
    "notTested",
    "seal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "contribsutra.audit-report"
    },
    "seal": {
      "type": "object",
      "required": [
        "hash"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "READY_FOR_HUMAN_REVIEW",
        "GAPS_FOUND",
        "ASSURANCE_FAILED"
      ]
    }
  },
  "additionalProperties": true
}
