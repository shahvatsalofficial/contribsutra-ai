{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shahvatsalofficial/contribsutra-ai/schemas/learning-plan.schema.json",
  "title": "contribsutra.learning-plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "mode",
    "issue",
    "blocked",
    "lifecycle",
    "steps",
    "status",
    "seal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "contribsutra.learning-plan"
    },
    "seal": {
      "type": "object",
      "required": [
        "hash"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "status": {
      "const": "PLANNED_NOT_EXECUTED"
    },
    "mode": {
      "enum": [
        "guided",
        "collaborative",
        "self-directed"
      ]
    }
  },
  "additionalProperties": true
}
