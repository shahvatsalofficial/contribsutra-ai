{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "maxItems": 250,
  "items": {
    "type": "object",
    "required": [
      "number",
      "title"
    ],
    "properties": {
      "number": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "labels": {
        "type": "array"
      }
    }
  }
}
