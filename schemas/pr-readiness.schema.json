{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shahvatsalofficial/contribsutra-ai/schemas/pr-readiness.schema.json",
  "title": "contribsutra.pr-readiness",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "reviewGate",
    "channels",
    "tests",
    "externalWrites",
    "seal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "contribsutra.pr-readiness"
    },
    "seal": {
      "type": "object",
      "required": [
        "hash"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reviewGate": {
      "const": "HUMAN_REVIEW_REQUIRED"
    },
    "externalWrites": {
      "const": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "verification": {
            "const": "unverified_external_claim"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
