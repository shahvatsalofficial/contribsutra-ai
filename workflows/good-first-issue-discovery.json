{
  "name": "good-first-issue-discovery",
  "version": "1.0",
  "trigger": "user_invoked_only",
  "defaultMode": "read_only",
  "steps": [
    {
      "id": "good-first-issue-discovery-1",
      "action": "Obtain explicitly authorized issue snapshot",
      "requiresApproval": true
    },
    {
      "id": "good-first-issue-discovery-2",
      "action": "Filter out closed/assigned/restricted issues",
      "requiresApproval": false
    },
    {
      "id": "good-first-issue-discovery-3",
      "action": "Rank with transparent labels and skill fit",
      "requiresApproval": false
    },
    {
      "id": "good-first-issue-discovery-4",
      "action": "Check maintainer invitation and issue freshness",
      "requiresApproval": false
    },
    {
      "id": "good-first-issue-discovery-5",
      "action": "Publish ranked shortlist and caveats",
      "requiresApproval": false
    }
  ],
  "executor": "documented_orchestrator_not_automated_in_v0.1"
}
